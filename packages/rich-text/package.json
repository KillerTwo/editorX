{
  "name": "@editorx/rich-text",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@editorx/theme": "workspace:^",
    "@editorx/toolbar": "workspace:^",
    "@editorx/ui": "workspace:^",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@editorx/theme": "workspace:*",
    "@editorx/toolbar": "workspace:*",
    "@editorx/ui": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "12.0.0",
    "ckeditor5": "49.0.0",
    "lucide-react": "^1.53.0"
  }
}
